# Copy to .env and fill in what you need. Everything here is optional for local use.

# Keeps you signed in to the same session across restarts. Any long random string.
SECRET_KEY=

# Where the database lives. Defaults to tracker.db next to run.py.
DATABASE_PATH=

# 127.0.0.1 = this PC only. Use 0.0.0.0 to open it to phones on the same Wi-Fi.
HOST=127.0.0.1
PORT=5000

# 1 turns on auto-reload and the debugger. Leave off outside development.
FLASK_DEBUG=0

# Gmail app password (email alerts, phase 4)
GMAIL_APP_PASSWORD=
SENDER_EMAIL=

# CallMeBot WhatsApp API (phase 4)
CALLMEBOT_API_KEY=
