# Copy to .env and fill in what you need. Everything here is optional for local use.

# Keeps you signed in to the same session across restarts. Any long random string.
SECRET_KEY=

# Where the database lives. Defaults to tracker.db next to run.py.
DATABASE_PATH=

# 127.0.0.1 = this PC only. Use 0.0.0.0 to open it to phones on the same Wi-Fi.
HOST=127.0.0.1
PORT=5000

# 1 turns on auto-reload and the debugger. Leave off outside development.
FLASK_DEBUG=0

# Store search. Leave BROWSER_CHANNEL blank to use Playwright's own Chromium if installed,
# otherwise Edge, otherwise Chrome. Or name one: msedge, chrome.
BROWSER_CHANNEL=
# 0 shows the browser window while it searches (handy if a store starts blocking).
BROWSER_HEADLESS=1
# Most listings to open per store in one search.
SEARCH_MAX_PER_STORE=24

# 0 stops the automatic price checks. How often they run is chosen in Settings.
SCHEDULER=1

# Email alerts: the Gmail address alerts are sent from, and an app password for it
# (Google Account > Security > 2-Step Verification > App passwords). Who receives them is set in Settings.
SENDER_EMAIL=
GMAIL_APP_PASSWORD=

# WhatsApp alerts through CallMeBot: the API key it sends you after you message its bot
# (see https://www.callmebot.com/blog/free-api-whatsapp-messages/). The number is set in Settings.
CALLMEBOT_API_KEY=
